# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (e.g., openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, perplexity/sonar, etc.)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Path to system prompt file
SYSTEM_PROMPT_PATH=config/system_prompt.md

# Database path for whatsmeow session
SESSION_DB_PATH=data/session.db

# Cooldown between triggers per chat in seconds
CHAT_COOLDOWN_SECONDS=3

# Context history limit (Set to 'all' or '0' for full conversation history, or specify a number like 20)
CONTEXT_HISTORY_LIMIT=all

# OpenRouter Voice & TTS Configuration (e.g. openai/tts-1 with voice: onyx, echo, alloy, fable, nova)
TTS_MODEL=openai/tts-1
TTS_VOICE=onyx

