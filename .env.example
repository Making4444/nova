# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL_CHAT=qwen/qwen3-235b-a22b-2507
MODEL_MATH=z-ai/glm-5.2
MODEL_VISION=openai/gpt-5.6-luna
MODEL_SUMMARIZER=google/gemini-3.7-flash

# Groq Configuration (STT Whisper & Fast Router)
GROQ_API_KEY=your_groq_api_key_here
MODEL_WHISPER=whisper-large-v3
MODEL_ROUTER_GROQ=qwen/qwen3.8-27b

# Path to system prompt file
SYSTEM_PROMPT_PATH=config/system_prompt.md

# Database path for whatsmeow session
SESSION_DB_PATH=data/session.db

# Cooldown between triggers per chat in seconds
CHAT_COOLDOWN_SECONDS=3

# Context history limit (Set to 'all' or '0' for full conversation history, or specify a number like 20)
CONTEXT_HISTORY_LIMIT=all

# OpenRouter Voice Configuration (e.g. openai/gpt-audio-mini with voice: onyx, echo, alloy, fable, nova)
TTS_MODEL=openai/gpt-audio-mini
TTS_VOICE=onyx

