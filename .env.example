# ==============================================================================
# Nova Bot - Environment Configuration Template
# Copy this file to .env and configure your secret keys and preferences.
# ==============================================================================

# ==============================================================================
# Signor AI Provider Configuration (Chat: gpt-6-luna | Specialists: Gemini | TTS)
# ==============================================================================
SIGNOR_API_KEY=your_signor_api_key_here

# Main Chat Model (GPT-6 Luna on v1)
SIGNOR_CHAT_BASE_URL=https://api.code.signor.ai/v1
SIGNOR_CHAT_MODEL=gpt-6-luna
MODEL_CHAT=gpt-6-luna

# Gemini Specialist Models (Math, Academic, Vision, Summarizer on api-4)
SIGNOR_GEMINI_BASE_URL=https://api.code.signor.ai/api-4/v1
MODEL_MATH=gemini-3.8-flash
MODEL_ACADEMIC=gemini-3.8-flash
MODEL_VISION=gemini-3.8-flash
MODEL_SUMMARIZER=gemini-3.8-flash

# Text-to-Speech / Voice Notes (Gemini 3.8 Flash TTS on api-2 generateContent)
SIGNOR_TTS_BASE_URL=https://api.code.signor.ai/api-2/v1
SIGNOR_TTS_MODEL=gemini-3.8-flash-tts
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore

# ==============================================================================
# Groq Credentials & Fast Routing Models (Whisper STT & Intent Router)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
MODEL_WHISPER=whisper-large-v3
MODEL_ROUTER_GROQ=qwen/qwen3.8-27b

# ==============================================================================
# Live Web Admin Dashboard Configuration
# ==============================================================================
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=nova_admin_2026

# ==============================================================================
# Execution, Cooldown & Context Management
# ==============================================================================
COOLDOWN_SECONDS=3
CONTEXT_HISTORY_LIMIT=all
MAX_TOKENS=4096

# ==============================================================================
# Session Database & System Prompt Paths
# ==============================================================================
SESSION_DB_PATH=data/session.db
SYSTEM_PROMPT_PATH=config/system_prompt.md
