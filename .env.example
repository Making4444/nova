# ==============================================================================
# Nova Bot - Environment Configuration Template
# Copy this file to .env and configure your secret keys and preferences.
# ==============================================================================

# OpenRouter AI Models & Credentials (Selected for lowest cost & highest Egyptian IQ from 2026 catalog)
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL_CHAT=qwen/qwen3-235b-a22b-2507
MODEL_MATH=nvidia/nemotron-3-super
MODEL_VISION=google/gemma-4-31b
MODEL_SUMMARIZER=deepseek/deepseek-v4-flash-0731

# Groq Credentials & Fast Routing Models
GROQ_API_KEY=your_groq_api_key_here
MODEL_WHISPER=whisper-large-v3
MODEL_ROUTER_GROQ=qwen/qwen3.8-27b

# OpenRouter Voice / Audio (TTS)
TTS_MODEL=openai/gpt-audio-mini
TTS_VOICE=onyx

# Live Web Admin Dashboard Configuration
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=nova_admin_2026

# Execution, Cooldown & Context Management
COOLDOWN_SECONDS=3
CONTEXT_HISTORY_LIMIT=all

# Session Database & System Prompt Paths
SESSION_DB_PATH=data/session.db
SYSTEM_PROMPT_PATH=config/system_prompt.md

